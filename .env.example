# =============================================================================
# PatchPilot — Environment Template
# =============================================================================

# PostgreSQL 16 connection URL (Configured for Supabase pooler)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# 32-byte AES-256-GCM master key as a 64-character hexadecimal string
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret admin token protecting /vault/{owner} endpoints (passed via X-Admin-Token header)
ADMIN_API_TOKEN=your-super-secret-admin-token-here

# Secret key used for signing user session JWT cookies
SESSION_SECRET=your-jwt-session-secret-here

# GitHub App Authentication
# Obtain these from: https://github.com/settings/apps/<your-app-slug>
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# GitHub OAuth App credentials (Optional for browser OAuth login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Clerk Authentication (Optional for clerk.com login)
# Obtain these from: https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_JWKS_URL=""
CLERK_FRONTEND_API=""

# Server Host & Port
HOST=0.0.0.0
PORT=8080
