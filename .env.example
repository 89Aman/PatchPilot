# =============================================================================
# PatchPilot — Environment Configuration Template
# Copy this file to `.env` before starting the server:
#   cp .env.example .env
# Strictly no real credentials or hardcoded tenant domains are included here.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database & Test Mode Configuration
# -----------------------------------------------------------------------------
# PostgreSQL 16 connection URL (Asyncpg or standard postgresql:// format; works with Supabase pooler)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contextlens

# Set TESTING=1 to use an in-memory SQLite database (sqlite+aiosqlite:///:memory:) for local evaluation & CI tests
TESTING=0

# -----------------------------------------------------------------------------
# 2. Deployment URLs & CORS
# -----------------------------------------------------------------------------
# Public origin of your PatchPilot deployment (used for redirects, webhooks, and PR links)
APP_BASE_URL=http://localhost:8080

# Comma-separated additional CORS origins (optional)
CORS_ALLOWED_ORIGINS=""
CORS_ALLOW_ORIGIN_REGEX=""

# Your GitHub App URL slug (e.g. from https://github.com/apps/<slug>)
GITHUB_APP_SLUG=""

# -----------------------------------------------------------------------------
# 3. Cryptographic Vault & Session Security
# -----------------------------------------------------------------------------
# 32-byte AES-256-GCM master encryption key encoded as a 64-character hexadecimal string
# Generate a production key with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret admin token protecting /vault/{owner} REST endpoints (passed via X-Admin-Token header)
ADMIN_API_TOKEN=super-secret-admin-token-change-me

# Secret key used for signing HMAC-SHA256 user session JWT cookies
# Falls back to ADMIN_API_TOKEN if left empty
SESSION_SECRET=mock-jwt-session-secret-change-in-production

# Keep false in production; only enable if allowing raw GitHub PAT linking
ALLOW_MANUAL_PAT=false

# -----------------------------------------------------------------------------
# 4. GitHub App Webhook & Installation Credentials
# Obtain from: https://github.com/settings/apps/<your-app-slug>
# -----------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAmockKeyDataForLocalDevelopmentOnly...\n-----END RSA PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# 5. GitHub OAuth Login (Optional — direct GitHub browser sign-in)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# 6. Clerk Authentication (Recommended for hosted SaaS)
# Obtain from: https://dashboard.clerk.com -> API Keys & Webhooks
# Ensure GitHub OAuth provider includes `read:user` and `read:org` scopes.
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_JWKS_URL=""
CLERK_FRONTEND_API=""
CLERK_ACCOUNTS_URL=""
CLERK_WEBHOOK_SIGNING_SECRET=""
WORKSPACE_MEMBERSHIP_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# 7. Commercial Billing (Polar.sh Merchant of Record — Per-Active-Committer)
# Leave BILLING_ENABLED=false for self-hosted open-source deployments.
# Set BILLING_ENABLED=true on hosted cloud (paid subscription required; no free tier/trial).
# -----------------------------------------------------------------------------
BILLING_ENABLED=false
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRO_PRODUCT_ID=""
POLAR_METER_EVENT_NAME=pr_reviewed
MANAGED_MONTHLY_REVIEW_CAP_PER_SEAT=300

# -----------------------------------------------------------------------------
# 8. Managed AI LLM Pool (Used by subscribed workspaces in 'managed' key mode)
# -----------------------------------------------------------------------------
MANAGED_LLM_PRIMARY_PROVIDER=gemini
MANAGED_LLM_PRIMARY_MODEL=gemini-2.5-flash
MANAGED_LLM_PRIMARY_API_KEY=""
MANAGED_LLM_PRIMARY_BASE_URL=""

MANAGED_LLM_FALLBACK_PROVIDER=groq
MANAGED_LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
MANAGED_LLM_FALLBACK_API_KEY=""
MANAGED_LLM_FALLBACK_BASE_URL=""

# -----------------------------------------------------------------------------
# 9. HTTP Server Binding
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
