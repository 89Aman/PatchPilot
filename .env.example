# =============================================================================
# PatchPilot — Environment Configuration Template
# Copy this file to `.env` before starting the server:
#   cp .env.example .env
# Strictly no real credentials are included in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database & Test Mode Configuration
# -----------------------------------------------------------------------------
# PostgreSQL 16 connection URL (Asyncpg or standard postgresql:// format; works with Supabase pooler)
# Default fallback in app/config.py: postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contextlens

# Set TESTING=1 to use an in-memory SQLite database (sqlite+aiosqlite:///:memory:) for local evaluation & CI tests
TESTING=0

# -----------------------------------------------------------------------------
# 2. Cryptographic Vault & Session Security
# -----------------------------------------------------------------------------
# 32-byte AES-256-GCM master encryption key encoded as a 64-character hexadecimal string
# Generate a production key with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret admin token protecting /vault/{owner} REST endpoints (passed via X-Admin-Token header)
ADMIN_API_TOKEN=super-secret-admin-token-change-me

# Secret key used for signing HMAC-SHA256 user session JWT cookies
# Falls back to ADMIN_API_TOKEN if left empty
SESSION_SECRET=mock-jwt-session-secret-change-in-production

# -----------------------------------------------------------------------------
# 3. GitHub App Webhook & Installation Credentials
# Obtain from: https://github.com/settings/apps/<your-app-slug>
# -----------------------------------------------------------------------------
# Numeric GitHub App ID
GITHUB_APP_ID=123456

# Webhook secret configured in your GitHub App settings for X-Hub-Signature-256 verification
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# PEM-encoded RSA private key for minting GitHub App installation tokens (supports \n escaped newlines)
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAmockKeyDataForLocalDevelopmentOnly...\n-----END RSA PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# 4. GitHub OAuth Login (Optional — for direct GitHub browser sign-in)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# 5. Clerk Authentication (Optional — for managed OAuth & session portal)
# Obtain from: https://dashboard.clerk.com -> API Keys
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_JWKS_URL=""
CLERK_FRONTEND_API=""

# -----------------------------------------------------------------------------
# 6. HTTP Server Binding
# -----------------------------------------------------------------------------
# Host interface and port for Uvicorn
HOST=0.0.0.0
PORT=8080
